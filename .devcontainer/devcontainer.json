{
  "name": "CivicGuard (Laravel Sail)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "CivicGuard", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "[ -x vendor/bin/sail ] && ./vendor/bin/sail up -d || true"
}
